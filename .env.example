# Copy to an ignored .env in YOUR worktree. See docs/shared-runtime.md.
# Generate a local SECRET_KEY; no default key is provided.
SECRET_KEY=
DEBUG=true
DATABASE_URL=sqlite:///db.sqlite3
ALLOWED_HOSTS=localhost,127.0.0.1
# Exact origins, comma or whitespace separated; no wildcard credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:8000
TRUST_CLOUDFLARE_PROXY=false
SECURE_SSL_REDIRECT=false
# Optional absolute collectstatic destination (default: worktree/staticfiles).
# STATIC_ROOT=

# Backend only. PLAT-03 implements Resend transport; no SMTP fallback.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=
EMAIL_REPLY_TO=
RESEND_TIMEOUT_SECONDS=30
RESEND_REQUESTS_PER_SECOND=2
RESEND_DAILY_REQUEST_BUDGET=100

# Backend only. DAWAH-02 implements R2 storage; blank slots do not enable it.
R2_ACCOUNT_ID=
R2_S3_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BUCKET=
# Public delivery HTTPS custom domain; no production r2.dev dependency.
R2_PUBLIC_DOMAIN=
R2_UPLOAD_INTENT_TTL_SECONDS=900
R2_PREVIEW_TTL_SECONDS=300
# Bucket CORS must be provisioned separately; these are exact frontend origins.
R2_CORS_ALLOWED_ORIGINS=http://localhost:5173
AUTOMATION_TIMEZONE=Africa/Lagos
AUTOMATION_CATCH_UP_DAYS=1
AUTOMATION_REMINDER_GRACE_SECONDS=900
