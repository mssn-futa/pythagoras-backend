# Copy to an ignored .env in YOUR worktree. See docs/shared-runtime.md.
# Generate a local SECRET_KEY; no default key is provided.
SECRET_KEY=
DEBUG=true
DATABASE_URL=sqlite:///db.sqlite3
ALLOWED_HOSTS=localhost,127.0.0.1
# Exact origins, comma or whitespace separated; no wildcard credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:8000
TRUST_CLOUDFLARE_PROXY=false
# Per-IP auth throttles (D5 starting limits). Raise refresh for shared campus IPs.
AUTH_REGISTER_RATE=5/min
AUTH_LOGIN_RATE=10/min
AUTH_REFRESH_RATE=10/min
SECURE_SSL_REDIRECT=false
# Optional absolute collectstatic destination (default: worktree/staticfiles).
# STATIC_ROOT=

# Backend only. Shared transport: pythagoras.mail (docs/identity-auth.md).
# resend = HTTPS Email API (default); memory = in-process, sends nothing (dev).
# There is no SMTP fallback. Tests always force memory with a blank key.
EMAIL_TRANSPORT=memory
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=
EMAIL_REPLY_TO=
# Total wall-clock bound per Resend request; welcome send uses the shorter bound.
RESEND_TIMEOUT_SECONDS=30
WELCOME_EMAIL_TIMEOUT_SECONDS=10
# Idempotency key prefix. Each environment (staging, production, ...) MUST
# set a distinct value, e.g. staging / production.
EMAIL_IDEMPOTENCY_NAMESPACE=local
# Outbox worker handoffs per second; keep it below the Resend account rate so
# welcome mail has headroom (docs/communication-outbox.md "Rate budget").
OUTBOX_REQUESTS_PER_SECOND=1
# Automated reminder links: {FRONTEND_BASE_URL}/dawah/events/{id} (blank leaves {{event_url}} empty).
FRONTEND_BASE_URL=

# Backend only. DAWAH-02 R2 storage (dawah/storage). Media storage stays
# disabled (uploads/publication return 503) until ALL of: endpoint (or account
# ID), key ID, secret, both buckets and an https public domain are set.
R2_ACCOUNT_ID=
# Optional; defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_S3_ENDPOINT_URL=
# Bucket-scoped token with Object Read & Write on both buckets only.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Private staging/ready bucket (no public access) and a DIFFERENT public bucket.
R2_PRIVATE_BUCKET=
R2_PUBLIC_BUCKET=
# Public delivery HTTPS custom domain of R2_PUBLIC_BUCKET; no production r2.dev.
R2_PUBLIC_DOMAIN=
# Signed PUT lifetime (D2: 15 minutes) and admin preview GET lifetime.
R2_UPLOAD_INTENT_TTL_SECONDS=900
R2_PREVIEW_TTL_SECONDS=300
# Bucket CORS must be provisioned separately; these are exact frontend origins.
R2_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Development only, and only with DEBUG=true: allow an *.r2.dev R2_PUBLIC_DOMAIN.
R2_ALLOW_R2_DEV_DOMAIN=false
# Optional: purge deleted public media URLs from the Cloudflare cache. Set both
# (zone ID of the media domain; API token with only Zone > Cache Purge) or neither.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_PURGE_API_TOKEN=
AUTOMATION_TIMEZONE=Africa/Lagos
AUTOMATION_CATCH_UP_DAYS=1
AUTOMATION_REMINDER_GRACE_SECONDS=900
